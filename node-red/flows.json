[
    {
        "id": "tab1",
        "type": "tab",
        "label": "Régie téléphones rotatifs",
        "disabled": false,
        "info": "Flow de départ : écoute les états/chiffres des 6 postes et permet de déclencher une sonnerie à distance. À étendre avec node-red-dashboard pour un vrai tableau de bord visuel."
    },
    {
        "id": "mqtt-broker1",
        "type": "mqtt-broker",
        "name": "Broker rotary-phones",
        "broker": "192.168.1.10",
        "port": "1883",
        "clientid": "",
        "usetls": false,
        "keepalive": "60",
        "cleansession": true
    },
    {
        "id": "state-in",
        "type": "mqtt in",
        "z": "tab1",
        "name": "phone/+/state",
        "topic": "phone/+/state",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt-broker1",
        "x": 200,
        "y": 100,
        "wires": [["state-debug"]]
    },
    {
        "id": "state-debug",
        "type": "debug",
        "z": "tab1",
        "name": "état des postes",
        "active": true,
        "tosidebar": true,
        "console": false,
        "complete": "true",
        "x": 440,
        "y": 100,
        "wires": []
    },
    {
        "id": "digit-in",
        "type": "mqtt in",
        "z": "tab1",
        "name": "phone/+/digit",
        "topic": "phone/+/digit",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt-broker1",
        "x": 200,
        "y": 160,
        "wires": [["digit-debug"]]
    },
    {
        "id": "digit-debug",
        "type": "debug",
        "z": "tab1",
        "name": "chiffres composés",
        "active": true,
        "tosidebar": true,
        "console": false,
        "complete": "true",
        "x": 440,
        "y": 160,
        "wires": []
    },
    {
        "id": "callstate-in",
        "type": "mqtt in",
        "z": "tab1",
        "name": "phone/+/call_state",
        "topic": "phone/+/call_state",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt-broker1",
        "x": 210,
        "y": 220,
        "wires": [["callstate-debug"]]
    },
    {
        "id": "callstate-debug",
        "type": "debug",
        "z": "tab1",
        "name": "état des appels",
        "active": true,
        "tosidebar": true,
        "console": false,
        "complete": "true",
        "x": 440,
        "y": 220,
        "wires": []
    },
    {
        "id": "ring-inject",
        "type": "inject",
        "z": "tab1",
        "name": "Sonner phone01",
        "props": [{ "p": "payload" }, { "p": "topic", "vt": "str" }],
        "repeat": "",
        "once": false,
        "topic": "phone/phone01/cmd/ring",
        "payload": "1",
        "payloadType": "str",
        "x": 200,
        "y": 300,
        "wires": [["ring-out"]]
    },
    {
        "id": "ring-out",
        "type": "mqtt out",
        "z": "tab1",
        "name": "",
        "topic": "",
        "qos": "",
        "retain": "",
        "broker": "mqtt-broker1",
        "x": 440,
        "y": 300,
        "wires": []
    }
]
