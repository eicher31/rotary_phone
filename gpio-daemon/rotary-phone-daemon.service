[Unit]
Description=Rotary phone GPIO/SIP/MQTT daemon
After=network-online.target baresip.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m gpio_daemon --config /etc/rotary-phone/config.yaml
Restart=on-failure
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
